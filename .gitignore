# 依赖
node_modules/
backend/.venv/
__pycache__/
*.pyc

# 不提交 lockfile：本机为 Windows，生成的 package-lock.json 只含 win32 原生二进制
# （@esbuild/win32-x64、@rollup/rollup-win32-x64-*），会导致 Linux CI 上 esbuild/rollup
# 缺少对应平台的原生二进制而构建失败。改为 CI 每次用 npm install 在 runner 上重新解析。
package-lock.json

# 构建产物（由 CI 重新构建，无需提交）
dist/
# 本地验证用构建输出（沙箱内绕过 safe-delete 拦截，outDir 放在仓库外的 dist_verify；
# 但有时也会落在仓库内，统一忽略，不污染 git status）
dist_verify/
dist_verify*/

# Vite 临时配置文件（构建时生成，构建后由 Vite 自行清理；
# 在带 safe-delete 拦截的沙箱里清理 rm 被拦截会残留，故忽略）
*.timestamp-*.mjs

# 已废弃的旧 monolith（已从 git 移除；磁盘残留因 Windows 文件锁暂未删除）
frontend/

# 运行时数据
data/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.log
